rules_version = '2';

//
// ADR-001 Backend-First Security Rules
// Phase 3 — Firestore Security Rules Lockdown
//
// Core principle (ADR-001):
//   All business writes must execute ONLY through the FastAPI backend
//   using the Firebase Admin SDK. The Flutter client is a read-only
//   presentation layer with respect to Firestore mutations.
//
// Write access matrix:
//   Collection              | Flutter client | FastAPI (Admin SDK)
//   ----------------------- | -------------- | -------------------
//   Users                   | READ only*     | WRITE
//   Menu                    | READ only      | WRITE
//   Orders                  | READ own**     | WRITE
//   Orders/tokens           | READ own**     | WRITE
//   queues                  | READ only      | WRITE
//   wallets                 | READ own       | WRITE
//   wallet_transactions     | READ own       | WRITE
//   pending_deposits        | READ own       | WRITE
//   refund_requests         | READ own       | WRITE
//
// * Users/read: own profile or admin
// ** Orders/read: owner or staff/admin
//
// The Firebase Admin SDK bypasses these rules entirely.
// Reads remain permitted so the existing StreamBuilder/FutureBuilder
// UI widgets continue to function without change.
//

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isStaff() {
      return signedIn() && (
        request.auth.token.role == 'staff' ||
        request.auth.token.staff == true ||
        isAdmin()
      );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Reads:  own profile or admin
    // Writes: BACKEND ONLY (Admin SDK bypasses rules)
    match /Users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Menu ──────────────────────────────────────────────────────────────────
    // Reads:  any authenticated user (required for menu display StreamBuilder)
    // Writes: BACKEND ONLY
    match /Menu/{menuId} {
      allow read: if signedIn();
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // Group orders are rendered in real time by clients, but every mutation is
    // server-side.  The array field also permits safe member-scoped document
    // reads without exposing groups to unrelated authenticated users.
    match /group_orders/{groupId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids || isStaff());
      allow write: if false;
    }

    // Internal, server-only code reservation map.
    match /group_order_codes/{code} {
      allow read, write: if false;
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // Reads:  order owner or staff/admin (required for order history + detail)
    // Writes: BACKEND ONLY
    match /Orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow write: if false;  // ADR-001: all writes via FastAPI backend

      // ── Tokens subcollection ───────────────────────────────────────────────
      // Reads:  order owner or staff (required for QR screen StreamBuilder)
      // Writes: BACKEND ONLY
      match /tokens/{tokenId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/Orders/$(orderId)).data.userId == request.auth.uid
          || isStaff()
        );
        allow write: if false;  // ADR-001: all writes via FastAPI backend
      }
    }

    // ── Queues ────────────────────────────────────────────────────────────────
    // Reads:  any authenticated user (required for queue display StreamBuilder)
    // Writes: BACKEND ONLY
    match /queues/{itemName} {
      allow read: if signedIn();
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Wallets ───────────────────────────────────────────────────────────────
    // Reads:  own wallet or admin
    // Writes: BACKEND ONLY
    match /wallets/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Wallet Transactions ────────────────────────────────────────────────────
    // Reads:  transaction owner or admin
    // Writes: BACKEND ONLY
    match /wallet_transactions/{transactionId} {
      allow read: if signedIn() && (
        resource.data.user_uid == request.auth.uid || isAdmin()
      );
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Pending Deposits ──────────────────────────────────────────────────────
    // Reads:  deposit owner or admin
    // Writes: BACKEND ONLY (Razorpay webhook → FastAPI → Admin SDK)
    match /pending_deposits/{depositId} {
      allow read: if signedIn() && (
        resource.data.user_uid == request.auth.uid || isAdmin()
      );
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Refund Requests ───────────────────────────────────────────────────────
    // Reads:  requester or admin
    // Writes: BACKEND ONLY (POST /api/wallet/refunds/request → Admin SDK)
    match /refund_requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.user_uid == request.auth.uid || isAdmin()
      );
      allow write: if false;  // ADR-001: all writes via FastAPI backend
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    // Any collection not explicitly listed above is denied to all clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
